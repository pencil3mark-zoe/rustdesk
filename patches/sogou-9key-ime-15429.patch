diff --git a/flutter/lib/models/soft_keyboard_input_utils.dart b/flutter/lib/models/soft_keyboard_input_utils.dart
new file mode 100644
index 00000000000..61a913c6907
--- /dev/null
+++ b/flutter/lib/models/soft_keyboard_input_utils.dart
@@ -0,0 +1,70 @@
+// Pure soft-keyboard text-diff helpers for the Android (non-iOS) controller input path.
+
+/// Computes the edit to push to the remote host given the previous (`oldValue`) and current
+/// (`newValue`) soft-keyboard text-field contents, both seeded with the `'1' * N` sentinel.
+///
+/// Returns the number of `VK_BACK` presses to send (`backspaces`) followed by the literal text
+/// to type (`insert`). Diffs on CONTENT, not length, so CJK in-place composing mutation is
+/// handled instead of silently dropped.
+({int backspaces, String insert}) computeSoftKeyboardEdit(
+    String oldValue, String newValue) {
+  // Align the diff window to the text after the last sentinel '1' in each string.
+  var i = newValue.length - 1;
+  for (; i >= 0 && newValue[i] != '1'; --i) {}
+  var j = oldValue.length - 1;
+  for (; j >= 0 && oldValue[j] != '1'; --j) {}
+  if (i < j) j = i;
+  final subNewValue = newValue.substring(j + 1);
+  final subOldValue = oldValue.substring(j + 1);
+
+  // Longest common prefix of the two windows.
+  var common = 0;
+  for (;
+      common < subOldValue.length &&
+          common < subNewValue.length &&
+          subNewValue[common] == subOldValue[common];
+      ++common) {}
+
+  final insert =
+      subNewValue.length > common ? subNewValue.substring(common) : '';
+  final backspaces = subOldValue.length - common;
+  return (backspaces: backspaces, insert: insert);
+}
+
+/// Reproduces the Android clipboard guard: when the sentinel-prefixed buffer is replaced by
+/// pasted text, treat the old value as empty so the whole new text is sent.
+String clipboardAdjustedOldValue(String oldValue, String newValue) {
+  if (oldValue.isNotEmpty &&
+      newValue.isNotEmpty &&
+      oldValue[0] == '1' &&
+      newValue[0] != '1') {
+    return '';
+  }
+  return oldValue;
+}
+
+const _autoInsertedBracketPairs = <String>{
+  '""', '()', '[]', '<>', '{}', '”“', '《》', '（）', '【】'
+};
+
+bool isAutoInsertedBracketPair(
+    String effectiveOldValue, int backspaces, String insert) {
+  return effectiveOldValue != '' &&
+      backspaces == 0 &&
+      _autoInsertedBracketPairs.contains(insert);
+}
+
diff --git a/flutter/test/soft_keyboard_input_utils_test.dart b/flutter/test/soft_keyboard_input_utils_test.dart
new file mode 100644
index 00000000000..7aad5b94468
--- /dev/null
+++ b/flutter/test/soft_keyboard_input_utils_test.dart
@@ -0,0 +1,66 @@
+import 'package:flutter_test/flutter_test.dart';
+import 'package:flutter_hbb/models/soft_keyboard_input_utils.dart';
+
+void main() {
+  group('computeSoftKeyboardEdit', () {
+    test('in-place CJK replacement with same length', () {
+      expect(computeSoftKeyboardEdit('1你', '1好'),
+          (backspaces: 1, insert: '好'));
+    });
+    test('pinyin composition commits to one Han character', () {
+      expect(computeSoftKeyboardEdit('1ni', '1你'),
+          (backspaces: 2, insert: '你'));
+    });
+    test('replace only changed tail of a Chinese phrase', () {
+      expect(computeSoftKeyboardEdit('1你好', '1你们'),
+          (backspaces: 1, insert: '们'));
+    });
+    test('Hangul in-place composition', () {
+      expect(computeSoftKeyboardEdit('1ㅁ', '1마'),
+          (backspaces: 1, insert: '마'));
+    });
+    test('append text', () {
+      expect(computeSoftKeyboardEdit('1你', '1你好'),
+          (backspaces: 0, insert: '好'));
+    });
+    test('multi-unit delete sends N backspaces', () {
+      expect(computeSoftKeyboardEdit('1中文', '1'),
+          (backspaces: 2, insert: ''));
+    });
+    test('bracket pair append', () {
+      expect(computeSoftKeyboardEdit('1', '1()'),
+          (backspaces: 0, insert: '()'));
+    });
+  });
+
+  group('clipboardAdjustedOldValue', () {
+    test('paste replaces sentinel -> empty old', () {
+      expect(clipboardAdjustedOldValue('1111', '你好'), '');
+    });
+    test('normal typing keeps old', () {
+      expect(clipboardAdjustedOldValue('1你', '1好'), '1你');
+    });
+    test('empty old does not throw', () {
+      expect(clipboardAdjustedOldValue('', '1你'), '');
+    });
+  });
+
+  group('isAutoInsertedBracketPair', () {
+    test('pair appended onto non-empty buffer', () {
+      expect(isAutoInsertedBracketPair('1', 0, '()'), true);
+    });
+    test('not a known pair', () {
+      expect(isAutoInsertedBracketPair('1', 0, 'ab'), false);
+    });
+    test('backspaces present is not auto-pair', () {
+      expect(isAutoInsertedBracketPair('1', 1, '()'), false);
+    });
+  });
+}
